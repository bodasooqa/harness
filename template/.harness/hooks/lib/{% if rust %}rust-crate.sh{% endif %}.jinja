#!/usr/bin/env bash
# shellcheck disable=SC2034  # переменные-выходы читает подключивший файл
# Крейт файла и проверки по крейту — общие для `rust-clippy.sh` (правка
# главной сессии) и `agent-checks.sh` (конец работы исполнителя). Модуль rust.
#
# Требует `lib/same-repo.sh`, подключённого раньше.

# rust_crate <файл> — крейт, которому принадлежит файл. Ставит переменные:
#   crate_pkg  — имя пакета для `cargo -p`;
#   crate_dir  — каталог крейта: область, по которой проверяется устаревание
#                вердикта, и каталог запуска cargo (пусто — текущий);
#   crate_file — путь файла в том же виде, что `crate_dir`.
# Код 1 — файл не крейта или не своего репозитория. Расширение не смотрит:
# какой файл достоин проверки, решает вызывающий.
rust_crate() {
  local f=$1
{% if monorepo %}
  # Воркспейс: крейт — каталог `crates/<имя>`, пакет — `{{ project_name }}-<имя>`.
  local crate
  crate=$(printf '%s' "$f" | sed -n 's|.*crates/\([^/][^/]*\)/.*|\1|p')
  [ -n "$crate" ] || return 1
  crate_pkg="{{ project_name }}-$crate"
  # Разбор средствами оболочки, как в `js-typecheck.sh`: путь может быть
  # и абсолютным, и относительным.
  case "$f" in
    crates/*) crate_dir="crates/$crate" ;;
    */crates/*) crate_dir="${f%%crates/*}crates/$crate" ;;
    *) crate_dir="" ;;
  esac
  crate_file=$f
{% else %}
  # Один крейт в корне: пакет — `{{ project_name }}`, область — корень проекта,
  # которому принадлежит файл. Сборочный каталог — не исходник.
  local file_dir
  case "$f" in
    */target/* | target/*) return 1 ;;
  esac
  case "$f" in
    /*) file_dir=${f%/*} ;;
    */*) file_dir=$PWD/${f%/*} ;;
    *) file_dir=$PWD ;;
  esac
  # git в каталоге файла — только когда он в дереве проекта (см. lib/same-repo.sh).
  same_repo "$file_dir" || return 1
  crate_dir=$(git -C "$file_dir" rev-parse --show-toplevel 2>/dev/null) || return 1
  [ -f "$crate_dir/Cargo.toml" ] || return 1
  # git даёт физический путь (на macOS `/private/var/…` вместо `/var/…`); путь
  # файла приводится к тому же виду, иначе проверка устаревания не узнает
  # в нём себя.
  crate_file="$(cd "$file_dir" && pwd -P)/${f##*/}"
  crate_pkg="{{ project_name }}"
{% endif %}
  # cargo исполняет build.rs, макросы и тулчейн из rust-toolchain.toml: файл
  # чужого клона не повод запускать их.
  same_repo "${crate_dir:-.}"
}

# rust_clippy <пакет> <каталог> — clippy по крейту с `-D warnings`, вывод
# в stdout, код — код clippy. Команда подменяема через `HARNESS_CLIPPY` (тесты).
# Запуск — из каталога крейта: файл соседнего дерева проверяется в своём
# дереве, а не в том, откуда позвали хук.
rust_clippy() {
  local pkg=$1 dir=${2:-.}
  # Разбиение `HARNESS_CLIPPY` на слова намеренно: по умолчанию это `cargo clippy`.
  # shellcheck disable=SC2086
  (cd "$dir" && ${HARNESS_CLIPPY:-cargo clippy} -p "$pkg" --all-targets --all-features -q -- -D warnings 2>&1)
}

# rust_fmt_check <файл>… — rustfmt без записи: код 1 и список расхождений,
# если файлы отформатированы не так. Редакция — та же, что у `rust-fmt.sh`.
# Цвета выключены: вывод уходит агенту текстом, а rustfmt красит и не в терминал.
rust_fmt_check() {
  rustfmt --edition 2024 --color never --check "$@" 2>&1
}
