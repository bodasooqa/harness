#!/usr/bin/env bash
# Слот post-edit-async (PostToolUse/Write|Edit, асинхронный), модуль frontend:
# проверяет типы в пакете, которому принадлежит файл. Выход 2 будит модель
# с текстом ошибки.
#
# Проверяющая команда подменяема через `HARNESS_TSC` — как `HARNESS_CLIPPY`
# у соседнего хука, и по той же причине: окно между вердиктом и диском
# воспроизводится подставной командой, а не расчётом на то, что настоящий
# `tsc` окажется медленнее стороннего сторожа.
#
# Предохранитель против шквала: вердикт, устаревший к моменту готовности,
# не будит — см. `lib/staleness.sh`. `tsc` считает секунды, а правка идёт
# пачкой: без предохранителя каждый промежуточный кадр рефакторинга будил
# сессию текстом о состоянии, которого на диске уже нет.
set -uo pipefail

here=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
# shellcheck source=lib/staleness.sh
. "$here/lib/staleness.sh"
# shellcheck source=lib/same-repo.sh
. "$here/lib/same-repo.sh"
# shellcheck source=lib/js-package.sh
. "$here/lib/js-package.sh"

input=$(cat)
# Правка субагента не будит главную сессию: исполнитель идёт по TDD,
# и красные промежуточные состояния — его рабочий ход, а не сигнал.
# Свои проверки он гоняет сам, главная сессия — полный прогон перед PR.
# Признак — поле `agent_id`: Claude Code кладёт его только в события субагентов.
[ -n "$(printf '%s' "$input" | jq -r '.agent_id // empty' 2>/dev/null)" ] && exit 0
f=$(printf '%s' "$input" | jq -r '.tool_response.filePath // .tool_input.file_path // empty' 2>/dev/null) || exit 0
case "$f" in
  *.ts|*.tsx) ;;
  *) exit 0 ;;
esac

# Пакет файла и его каталог — `lib/js-package.sh`.
pkg_dir=""
pkg_file=""
js_package "$f" || exit 0
dir=$pkg_dir
f=$pkg_file

mark=$(stale_marker)
trap 'stale_drop "$mark"' EXIT

out=$(js_tsc "$dir") && exit 0

# Дерево ушло вперёд, пока считали: правка пачкой продолжается, и этот вердикт
# уже не о том, что лежит на диске. Следующая правка запустит проверку заново,
# а у последней правки пачки следующей не будет — она и доложит.
stale_since "$mark" "$dir" "$f" && exit 0

printf 'tsc: %s не проходит проверку типов\n\n%s\n' "$dir" "$(printf '%s' "$out" | tail -40)" >&2
exit 2
