#!/usr/bin/env bash
# Slot post-edit-async (PostToolUse/Write|Edit, asynchronous), module frontend:
# type-checks the package the file belongs to. Exit 2 wakes the model
# with the error text.
#
# The checking command can be substituted via `HARNESS_TSC` — like `HARNESS_CLIPPY`
# in the neighbouring hook, and for the same reason: the window between the
# verdict and the disk is reproduced with a stand-in command, not by counting on
# the real `tsc` being slower than a third-party watcher.
#
# Fuse against a flood: a verdict that is stale by the time it is ready doesn't
# wake anyone — see `lib/staleness.sh`. `tsc` takes seconds, and edits come
# in batches: without the fuse every intermediate frame of a refactoring woke
# the session with text about a state no longer on disk.
set -uo pipefail

here=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
# shellcheck source=lib/staleness.sh
. "$here/lib/staleness.sh"
# shellcheck source=lib/same-repo.sh
. "$here/lib/same-repo.sh"
# shellcheck source=lib/js-package.sh
. "$here/lib/js-package.sh"

input=$(cat)
# A subagent's edit doesn't wake the main session: the executor follows TDD,
# and red intermediate states are its working moves, not a signal.
# It runs its own checks; the main session does a full run before the PR.
# The marker is the `agent_id` field: Claude Code puts it only in subagent events.
[ -n "$(printf '%s' "$input" | jq -r '.agent_id // empty' 2>/dev/null)" ] && exit 0
f=$(printf '%s' "$input" | jq -r '.tool_response.filePath // .tool_input.file_path // empty' 2>/dev/null) || exit 0
case "$f" in
  *.ts|*.tsx) ;;
  *) exit 0 ;;
esac

# The file's package and its directory — `lib/js-package.sh`.
pkg_dir=""
pkg_file=""
js_package "$f" || exit 0
dir=$pkg_dir
f=$pkg_file

mark=$(stale_marker)
trap 'stale_drop "$mark"' EXIT

out=$(js_tsc "$dir") && exit 0

# The worktree moved on while we were checking: the batch of edits continues, and
# this verdict is no longer about what is on disk. The next edit restarts the
# check, and the last edit of the batch has no next one — it will report.
stale_since "$mark" "$dir" "$f" && exit 0

printf 'tsc: %s fails type checking\n\n%s\n' "$dir" "$(printf '%s' "$out" | tail -40)" >&2
exit 2
