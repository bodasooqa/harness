#!/usr/bin/env bash
# Slot post-edit (PostToolUse/Write|Edit), module frontend: formats and fixes
# the JS/TS/CSS file that was just written.
set -uo pipefail

f=$(jq -r '.tool_response.filePath // .tool_input.file_path // empty' 2>/dev/null) || exit 0
case "$f" in
  *.ts|*.tsx|*.js|*.jsx|*.json|*.jsonc|*.css) ;;
  *) exit 0 ;;
esac
case "$f" in
  # A fixture is an external response byte for byte: guarded by path, not by an
  # exclusion in `biome.json`, which the project may not have set up.
  */tests/fixtures/*) exit 0 ;;
esac
[ -f "$f" ] || exit 0

# biome takes biome.json and its exclusions from the directory it runs in. A file
# of a neighbouring worktree is formatted from the root of its own worktree,
# otherwise the wrong exclusions apply and that worktree's generated files get
# rewritten. The binary is the project's only: the file may live in a foreign
# clone, and its node_modules must not be executed. The biome config executes
# no code, so a foreign worktree may supply it.
project=${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")}
# The path is physical and relative to the worktree root: git returns the root
# without symlinks (/private/var, not /var), and with another spelling biome
# considers the file foreign.
dir=$(cd "$(dirname "$f")" && pwd -P) || exit 0
tree=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || tree=$dir
file=${dir#"$tree"}/$(basename "$f")
file=${file#/}
biome=$project/node_modules/.bin/biome
[ -x "$biome" ] || exit 0

(cd "$tree" && "$biome" check --write --no-errors-on-unmatched "$file") >/dev/null 2>&1 || true
exit 0
