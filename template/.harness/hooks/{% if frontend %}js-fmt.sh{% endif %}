#!/usr/bin/env bash
# Слот post-edit (PostToolUse/Write|Edit), модуль frontend: форматирует и чинит
# только что записанный JS/TS/CSS файл.
set -uo pipefail

f=$(jq -r '.tool_response.filePath // .tool_input.file_path // empty' 2>/dev/null) || exit 0
case "$f" in
  *.ts|*.tsx|*.js|*.jsx|*.json|*.jsonc|*.css) ;;
  *) exit 0 ;;
esac
case "$f" in
  # Фикстура — внешний ответ байт в байт: охраняется по пути, а не исключением
  # в `biome.json`, которое проект мог и не завести.
  */tests/fixtures/*) exit 0 ;;
esac
[ -f "$f" ] || exit 0

# biome берёт biome.json и его исключения из каталога запуска. Файл соседнего
# дерева форматируется из корня своего дерева, иначе исключения действуют
# чужие и generated этого дерева будет переписан. Бинарь — только проектный:
# файл может лежать в чужом клоне, и исполнять его node_modules нельзя.
# Конфиг biome кода не исполняет, его чужое дерево дать может.
project=${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || printf '%s' "$PWD")}
# Путь — физический и от корня дерева: git отдаёт корень без симлинков
# (/private/var, а не /var), и с другим написанием biome считает файл чужим.
dir=$(cd "$(dirname "$f")" && pwd -P) || exit 0
tree=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || tree=$dir
file=${dir#"$tree"}/$(basename "$f")
file=${file#/}
biome=$project/node_modules/.bin/biome
[ -x "$biome" ] || exit 0

(cd "$tree" && "$biome" check --write --no-errors-on-unmatched "$file") >/dev/null 2>&1 || true
exit 0
