cargo test --workspace
cargo clippy --workspace --all-targets --all-features -- -D warnings
cargo fmt --all --check
cargo run -p {{ project_name }}-<crate>
{% elif rust %}
# Rust
cargo check
cargo test
cargo clippy --all-targets --all-features -- -D warnings
cargo fmt --check
cargo run
{% endif %}
{% if rust and frontend %}

{% endif %}
{% if frontend %}
# Frontend
bun install
bun run typecheck
bun run build
bun run test
bun run lint                 # biome check .
bun run lint:fix             # biome check --write .
