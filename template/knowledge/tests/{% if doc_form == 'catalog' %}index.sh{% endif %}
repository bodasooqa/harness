#!/usr/bin/env bash
# Tests for `knowledge/index.sh`: the table of contents is built from the
# directory's files, a second run does not change it, a README without markers
# is an error, `--stage` stages the changed README. The project is synthetic,
# in a temporary directory.
#
# Run: knowledge/tests/index.sh
set -uo pipefail

# Under a git hook the environment carries GIT_DIR and friends: git would look
# at the hook's repository instead of the temporary one.
while IFS='=' read -r name _; do
  case "$name" in GIT_*) unset "$name" ;; esac
done < <(env)

here=$(cd "${BASH_SOURCE[0]%/*}" && pwd)
script="$here/../index.sh"

pass=0
fail=0
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

ok()  { pass=$((pass + 1)); printf '  ok   %s\n' "$1"; }
bad() { fail=$((fail + 1)); printf '  FAIL %s\n     expected: %s\n     got: %s\n' "$1" "$2" "${3:-<empty>}"; }

toc='<!-- toc: built by knowledge/index.sh, do not edit -->\n_empty_\n<!-- /toc -->\n'

setup() {
  rm -rf "$tmp/repo"
  mkdir -p "$tmp/repo/knowledge/decisions" "$tmp/repo/knowledge/lessons"
  cp "$script" "$tmp/repo/knowledge/"
  printf '[answers]\ndecisions_path = "knowledge/decisions"\nlessons_path = "knowledge/lessons"\n' > "$tmp/repo/.rootstock.toml"
  printf "# Decisions\n\nFormat.\n\n$toc" > "$tmp/repo/knowledge/decisions/README.md"
  printf "# Lessons\n\n$toc" > "$tmp/repo/knowledge/lessons/README.md"
}

echo "index.sh"

setup
out=$("$tmp/repo/knowledge/index.sh" 2>&1); code=$?
{ [ $code -eq 0 ] && [ -z "$out" ] && grep -q '^_empty_$' "$tmp/repo/knowledge/decisions/README.md"; } \
  && ok "empty directory — empty table of contents, files untouched" \
  || bad "empty directory — empty table of contents, files untouched" "silence, _empty_" "exit $code: $out"

printf '# Second decision\n\nText.\n' > "$tmp/repo/knowledge/decisions/2026-10-02-second.md"
printf '# First decision\n\nText.\n' > "$tmp/repo/knowledge/decisions/2026-10-01-first.md"
printf '# Lesson\n' > "$tmp/repo/knowledge/lessons/2026-10-03-lesson.md"
"$tmp/repo/knowledge/index.sh" >/dev/null 2>&1; code=$?
block=$(sed -n '/<!-- toc:/,/<!-- \/toc -->/p' "$tmp/repo/knowledge/decisions/README.md" | sed '1d;$d')
want='- [First decision](2026-10-01-first.md)
- [Second decision](2026-10-02-second.md)'
{ [ $code -eq 0 ] && [ "$block" = "$want" ]; } \
  && ok "decisions table of contents by file name" || bad "decisions table of contents by file name" "$want" "exit $code: $block"
grep -qF -- '- [Lesson](2026-10-03-lesson.md)' "$tmp/repo/knowledge/lessons/README.md" \
  && ok "lessons table of contents" || bad "lessons table of contents" "the lesson line" "$(cat "$tmp/repo/knowledge/lessons/README.md")"
grep -q '^Format\.$' "$tmp/repo/knowledge/decisions/README.md" \
  && ok "text outside the markers untouched" || bad "text outside the markers untouched" "Format." "$(cat "$tmp/repo/knowledge/decisions/README.md")"

before=$(cat "$tmp/repo/knowledge/decisions/README.md")
out=$("$tmp/repo/knowledge/index.sh" 2>&1)
{ [ -z "$out" ] && [ "$before" = "$(cat "$tmp/repo/knowledge/decisions/README.md")" ]; } \
  && ok "a second run changes nothing" || bad "a second run changes nothing" "silence" "$out"

printf '# Lessons\n\nNo markers.\n' > "$tmp/repo/knowledge/lessons/README.md"
out=$("$tmp/repo/knowledge/index.sh" 2>&1); code=$?
{ [ $code -eq 1 ] && [[ "$out" == *"no table of contents markers"* ]]; } \
  && ok "README without markers — exit 1" || bad "README without markers — exit 1" "exit 1 and a complaint" "exit $code: $out"

# --stage: the new entry is staged, the README is not; after the run the README is too.
setup
git -C "$tmp/repo" init -q
git -C "$tmp/repo" add -A
git -C "$tmp/repo" -c user.email=t@t -c user.name=t commit -q -m base
printf '# Decision\n' > "$tmp/repo/knowledge/decisions/2026-10-05-new.md"
git -C "$tmp/repo" add knowledge/decisions/2026-10-05-new.md
(cd "$tmp/repo" && ./knowledge/index.sh --stage >/dev/null 2>&1)
staged=$(git -C "$tmp/repo" diff --cached --name-only | sort | tr '\n' ' ')
[ "$staged" = "knowledge/decisions/2026-10-05-new.md knowledge/decisions/README.md " ] \
  && ok "--stage stages the README" || bad "--stage stages the README" "the entry and the README" "$staged"

echo
printf 'total: %d passed, %d failed\n' "$pass" "$fail"
[ "$fail" -eq 0 ]
