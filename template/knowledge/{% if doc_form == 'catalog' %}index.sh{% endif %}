#!/usr/bin/env bash
# Tables of contents for the decisions and lessons directories.
#
# Decisions and lessons are one file per entry; a directory's table of
# contents is the list of entries in its README.md between the markers
#   <!-- toc: built by knowledge/index.sh, do not edit -->
#   <!-- /toc -->
# A hand-kept table of contents drifts from the contents with the first
# forgotten file. Here it is derived from the files, and pre-commit keeps it,
# not discipline.
#
# A table of contents line is `- [Title](file.md)`: the title is the file's
# first `# ` line, the order is by file name (the name starts with a date).
#
# Modes:
#   index.sh           rewrites the tables of contents; exit 1 if a README has no markers
#   index.sh --stage   the same, and stages the changed READMEs — this is how
#                      pre-commit calls it: the new entry is staged, the README usually is not
#
# Directories are `decisions_path` and `lessons_path` from `.rootstock.toml`.
set -euo pipefail

root=$(cd "${BASH_SOURCE[0]%/*}/.." && pwd)
answers="$root/.rootstock.toml"

mode=${1:-}
case "$mode" in
  "" | --stage) ;;
  --help | -h)
    sed -n '2,20p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  *)
    printf 'index.sh: unknown argument %s. Expected --stage or nothing.\n' "$mode" >&2
    exit 2
    ;;
esac

# Value of a key from the `[answers]` table of the template record:
# `key = "value"`, quotes stripped. Escapes are not expanded: paths have none.
answer() {
  local key=$1 value
  value=$(awk -v key="$key" -v q="'" '
    /^[ \t]*\[/ { inside = ($0 ~ /^[ \t]*\[answers\][ \t]*$/); next }
    inside && $0 ~ ("^" key "[ \t]*=") {
      v = substr($0, index($0, "=") + 1)
      sub(/^[ \t]+/, "", v)
      sub(/[ \t]+$/, "", v)
      f = substr(v, 1, 1)
      if (length(v) >= 2 && (f == "\"" || f == q) && substr(v, length(v), 1) == f)
        v = substr(v, 2, length(v) - 2)
      print v
      exit
    }
  ' "$answers")
  if [[ -z "$value" ]]; then
    printf 'index.sh: %s has no key %s\n' "$answers" "$key" >&2
    exit 1
  fi
  value=${value#./}
  value=${value%/}
  printf '%s\n' "$value"
}

if [[ ! -f "$answers" ]]; then
  printf 'index.sh: no template answers file %s\n' "$answers" >&2
  exit 1
fi

cd "$root"

status=0
for dir in "$(answer decisions_path)" "$(answer lessons_path)"; do
  readme="$dir/README.md"
  [[ -f "$readme" ]] || continue
  rc=0
  perl -CSD -Mutf8 -0777 -e '
    my ($dir, $readme) = @ARGV;
    open my $fh, "<:encoding(UTF-8)", $readme or die "cannot read $readme: $!\n";
    my $text = do { local $/; <$fh> };
    close $fh;

    unless ($text =~ /<!-- toc:.*?-->/s) {
      warn "$readme: no table of contents markers, skipped\n";
      exit 3;
    }

    opendir my $dh, $dir or die "cannot read $dir: $!\n";
    my @files = sort grep { /\.md\z/ && $_ ne "README.md" && -f "$dir/$_" } readdir $dh;
    closedir $dh;

    my @items;
    for my $f (@files) {
      open my $ef, "<:encoding(UTF-8)", "$dir/$f" or die "cannot read $dir/$f: $!\n";
      my $title;
      local $/ = "\n";
      while (my $l = <$ef>) {
        if ($l =~ /^# (.+?)\s*$/) { $title = $1; last }
      }
      close $ef;
      $title //= $f;
      push @items, "- [$title]($f)";
    }
    my $block = @items ? join("\n", @items) : "_empty_";

    my $new = $text;
    $new =~ s{(<!-- toc:.*?-->\n).*?(<!-- /toc -->)}{$1$block\n$2}s
      or die "$readme: table of contents markers are not paired\n";

    exit 0 if $new eq $text;
    open my $out, ">:encoding(UTF-8)", $readme or die "cannot write $readme: $!\n";
    print $out $new;
    close $out;
    print "table of contents updated: $readme\n";
    exit 4;
  ' "$dir" "$readme" || rc=$?
  case "$rc" in
    0) ;;
    3) status=1 ;;
    4) [[ "$mode" == --stage ]] && git add -- "$readme" ;;
    *) exit 1 ;;
  esac
done

exit "$status"
