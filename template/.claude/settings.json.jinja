{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
{% if rust %}
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo test *)",
      "Bash(cargo clippy *)",
      "Bash(cargo fmt *)",
      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(rustfmt *)",
{% endif %}
{% if frontend %}
      "Bash(bun install)",
      "Bash(bun install --frozen-lockfile)",
      "Bash(bun test)",
      "Bash(bun test *)",
      "Bash(bun run build)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run lint)",
      "Bash(bun run lint:fix)",
      "Bash(bun run format)",
      "Bash(bunx tsc --noEmit)",
      "Bash(bunx tsc --noEmit *)",
      "Bash(bunx biome check *)",
      "Bash(bunx biome format *)",
      "Bash(biome check *)",
      "Bash(biome format *)",
      "Bash(biome lint *)",
      "Bash(turbo run *)",
{% endif %}
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(jq *)",
      "Bash(openspec status *)",
      "Bash(openspec instructions *)",
      "Bash(openspec list *)",
      "Bash(openspec show *)",
      "Bash(openspec validate *)",
      "Bash(openspec schemas *)",
      "Bash(openspec templates *)",
      "Bash(openspec context *)",
      "Bash(openspec doctor *)",
      "Bash(openspec store list *)",
      "Bash(openspec new change *)",
      "Bash(openspec change *)",
      "Bash(openspec spec *)",
      "Bash(openspec archive *)",
      "Bash(lefthook validate)",
      "Bash(shellcheck *)"
    ],
    "deny": [
      "Bash(rg *--pre*)",
      "Bash(git diff *--output*)",
      "Bash(git diff *--ext-diff*)",
      "Bash(git log *--output*)",
      "Bash(git log *--ext-diff*)",
      "Bash(git show *--output*)",
      "Bash(git show *--ext-diff*)",
{% if rust %}
      "Bash(cargo *--config*)",
{% endif %}
{% if frontend %}
      "Bash(bun test *--reporter-outfile*)",
      "Bash(bun test *--coverage-dir*)",
      "Bash(biome *--log-file*)",
      "Bash(biome *--reporter-file*)",
      "Bash(bunx biome *--log-file*)",
      "Bash(bunx biome *--reporter-file*)",
      "Bash(turbo *--graph*)",
      "Bash(turbo *-profile*)",
{% endif %}
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.claude/commands/opsx/**)",
      "Edit(./.claude/skills/openspec-**)",
      "Edit(./.pi/prompts/opsx-*)",
      "Edit(./.pi/skills/openspec-**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" session-start",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" session-end",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" prompt",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" pre-bash",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" post-edit",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" post-edit-async",
            "timeout": 300,
            "async": true,
            "asyncRewake": true,
            "statusMessage": "{% if rust and frontend %}clippy и tsc по затронутому пакету{% elif rust %}clippy по затронутому крейту{% else %}tsc по затронутому пакету{% endif %}"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.harness/hooks/dispatch.sh\" post-bash",
            "timeout": 10
          }
        ]
      }
    ]
{% if frontend %}
  },
  "worktree": {
    "symlinkDirectories": ["node_modules"]
{% endif %}
{% if rust %}
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true
{% endif %}
  }
}
