{#
  Agent metadata — a single source for `.claude/agents/` and `.pi/agents/`.
  The agent body is `<name>.md.jinja` next to this file. Included like this:
  `{% from 'template/_partials/agents/meta.jinja' import agents, pi_tools with context %}`.

  `tools` are Claude Code tool names; for Pi they are translated by `pi_tools` via the
  `pi_tool_names` table (Pi tools — documentation of the `@gotgenes/pi-subagents` package,
  section "Tool selection"). In Claude, `Glob` finds both files and directories; in Pi that is `find` and `ls`.

  `model` is a Claude Code model class; in Pi it is translated by the `pi_models` template question.
#}
{% set agents = {
  "rust-developer": {
    "description": "Executor in the Rust part" ~ (" (crates/)" if monorepo else "") ~ ". Takes a well-defined task with the decision already made and carries it to green checks. Knows the package boundaries and the project's code rules. Makes no decisions — returns anything debatable as a question.",
    "tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
    "model": "sonnet",
  },
  "rust-reviewer": {
    "description": "Review of the Rust part — panics and unwrap outside tests, unsafe, blocking calls in async, magic numbers instead of configuration, println and secrets in logs, silent handling of forbidden cases. Run before committing Rust changes.",
    "tools": ["Read", "Grep", "Glob", "Bash"],
    "model": "opus",
  },
  "frontend-developer": {
    "description": "Executor in the frontend" ~ (" (apps/ and packages/)" if monorepo else "") ~ " — screens and UIKit components. Takes a well-defined task with the decision already made and carries it to green checks. Knows the shadcn convention and the rule \"a screen is assembled from ready UIKit components\". Makes no decisions — returns anything debatable as a question.",
    "tools": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
    "model": "sonnet",
  },
  "frontend-reviewer": {
    "description": "Review of the frontend — the boundary between UIKit and screens, the shadcn convention, theme tokens instead of colors, types only from the contract, accessibility. Run before committing the frontend part.",
    "tools": ["Read", "Grep", "Glob", "Bash"],
    "model": "opus",
  },
  "spec-auditor": {
    "description": "Checks the implementation against the spec (" ~ spec_path ~ ") — the paragraphs a change references, the general invariants and the domain invariants from the project addendum, package boundaries. Run before stage acceptance, before archiving a change that alters product behavior, and after any change to a contract or data schema.",
    "tools": ["Read", "Grep", "Glob", "Bash"],
    "model": "opus",
  },
} %}
{% set pi_tool_names = {
  "Read": ["read"],
  "Grep": ["grep"],
  "Glob": ["find", "ls"],
  "Bash": ["bash"],
  "Edit": ["edit"],
  "Write": ["write"],
} %}
{% macro pi_tools(tools) %}{% set names = [] %}{% for tool in tools %}{% for name in pi_tool_names[tool] %}{% set _ = names.append(name) %}{% endfor %}{% endfor %}{{ names | join(", ") }}{% endmacro %}
