{% set gh = "${{" %}
# Shared harness checks. Managed file: updated by the template, not edited
# by hand. Called from the project's `ci.yml` (`uses: ./.github/workflows/harness.yml`);
# the project writes its own jobs there.
#
# They share responsibility with lefthook: it guards commit and push on the
# developer's machine, CI guards what a local hook may miss: bypass via
# --no-verify and glob filters.
name: harness

on:
  workflow_call:
    inputs:
      runs-on:
        description: Runner, a label string (`ubuntu-latest`) or a JSON array of labels (`["self-hosted", "ci"]`)
        type: string
        default: ubuntu-latest
{% if rust %}
      # A project whose build needs its own environment (a database in services,
      # variables, custom steps) is hindered by the shared rust job: it runs next
      # to the project's own and fails without that environment. Such a project
      # turns it off and writes rust in its own ci.yml.
      rust:
        description: Shared rust job (fmt, clippy, test). false means the project checks Rust with its own job
        type: boolean
        default: true
{% endif %}
{% if frontend %}
      js:
        description: Shared js job (typecheck, lint, test, build). false means the project checks JS with its own job
        type: boolean
        default: true
{% endif %}

env:
  CARGO_TERM_COLOR: always

jobs:
  # Which jobs this change needs. A README edit should not cost a build run.
  # A filter mistake is dangerous only one way: a skipped check looks green.
  # So the expensive rust job has an inverted condition: it runs on any file
  # unless it is in an explicit list of what cargo doesn't see. A new directory
  # forgotten here triggers it rather than silently skipping it.
  # js and harness are cheap, a direct list is enough for them.
  changes:
    name: changes
    runs-on: {{ gh }} startsWith(inputs.runs-on, '[') && fromJSON(inputs.runs-on) || inputs.runs-on }}
    # Every job has a timeout: a hung job without one (6 hours by default)
    # holds the runner queue.
    timeout-minutes: 5
    permissions:
      contents: read
      pull-requests: read
    outputs:
{% if rust %}
      rust: {{ gh }} steps.code.outputs.rust }}
{% endif %}
{% if frontend %}
      js: {{ gh }} steps.any.outputs.js }}
{% endif %}
      harness: {{ gh }} steps.any.outputs.harness }}
    steps:
      - uses: actions/checkout@v7
{% if rust %}

      - id: code
        uses: dorny/paths-filter@v3
        with:
          predicate-quantifier: every
          filters: |
            rust:
              - "**"
              - "!**/*.md"
{% if frontend and monorepo %}
              - "!apps/**"
              - "!packages/**"
              - "!biome.json"
              - "!turbo.json"
              - "!package.json"
              - "!bun.lock"
{% endif %}
              - "!.claude/**"
              - "!.pi/**"
              - "!.harness/**"
              - "!knowledge/**"
              - "!openspec/**"
              - "!.mcp.json"
              - "!lefthook.yml"
              - "!.rootstock.toml"
{% endif %}

      - id: any
        uses: dorny/paths-filter@v3
        with:
          filters: |
{% if frontend %}
            js:
              - "**/*.{js,jsx,ts,tsx,mjs,cjs,json,jsonc,css,html}"
{% if monorepo %}
              - apps/**
              - packages/**
{% else %}
              - src/**
{% endif %}
              - bun.lock
              - .github/workflows/**
{% endif %}
            harness:
              - .harness/**
              - .claude/**
              - .codex/**
              - .pi/**
              - knowledge/**
              - lefthook.yml
              - .rootstock.toml
              - "{{ open_questions_path }}"
              - "{{ stages_path }}"
{% if doc_form == 'catalog' %}
              - "{{ spec_path }}/**"
              - "{{ revisions_path }}/**"
{% endif %}
{% if frontend %}
              - package.json
              - bun.lock
{% endif %}
{% if rust %}
              - rust-toolchain.toml
{% endif %}
              - .github/workflows/**
{% if rust %}

  rust:
    name: rust
    needs: changes
    if: inputs.rust && needs.changes.outputs.rust == 'true'
    runs-on: {{ gh }} startsWith(inputs.runs-on, '[') && fromJSON(inputs.runs-on) || inputs.runs-on }}
    timeout-minutes: 40
    steps:
      - uses: actions/checkout@v7

      # The toolchain comes from rust-toolchain.toml: rustup installs the
      # components itself. The GitHub cache is only for a clean machine: a
      # self-hosted runner keeps its build directory.
      - uses: Swatinem/rust-cache@v2
        if: runner.environment == 'github-hosted'

      - name: Formatting
        run: cargo fmt --all --check

      - name: Clippy
        run: cargo clippy{% if monorepo %} --workspace{% endif %} --all-targets --all-features -- -D warnings

      - name: Tests
        run: cargo test{% if monorepo %} --workspace{% endif %}

{% endif %}
{% if frontend %}

  js:
    name: js
    needs: changes
    if: inputs.js && needs.changes.outputs.js == 'true'
    runs-on: {{ gh }} startsWith(inputs.runs-on, '[') && fromJSON(inputs.runs-on) || inputs.runs-on }}
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@v7

      # The bun version comes from packageManager in package.json.
      - uses: oven-sh/setup-bun@v2
        with:
          bun-version-file: package.json
{% if monorepo %}

      # turbo cache on top of the GitHub Actions cache: no account, no secrets.
      - uses: rharkor/caching-for-turbo@v2.5.1
{% endif %}

      - name: Install
        run: bun install --frozen-lockfile

      - name: Types
        run: bun run typecheck

      - name: Lint
        run: bun run lint

      - name: Tests
        run: bun run test

      - name: Build
        run: bun run build
{% endif %}

  # Merge conflict markers. A harness update conflict (rootstock update) stays
  # as markers in files, and its PR must be red, otherwise harness-automerge.yml
  # would merge it. Runs on any change, without a filter: a marker can end up
  # in any file.
  markers:
    name: markers
    runs-on: {{ gh }} startsWith(inputs.runs-on, '[') && fromJSON(inputs.runs-on) || inputs.runs-on }}
    timeout-minutes: 5
    steps:
      - uses: actions/checkout@v7

      - name: No conflict markers
        run: ./.harness/update/conflict-markers.sh

  harness:
    name: harness
    needs: changes
    if: needs.changes.outputs.harness == 'true'
    runs-on: {{ gh }} startsWith(inputs.runs-on, '[') && fromJSON(inputs.runs-on) || inputs.runs-on }}
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@v7

      # The tests run lefthook on temporary repositories{% if rust %}, call rustfmt{% endif %}{% if frontend %}, bunx biome and tsc{% endif %}; the Pi layer runs under bun test.
      - uses: oven-sh/setup-bun@v2
{% if frontend %}
        with:
          bun-version-file: package.json

      - name: Install
        run: bun install --frozen-lockfile
{% else %}
        with:
          bun-version: latest

      - name: lefthook
        run: bun add --global lefthook@2.1.12
{% endif %}

      - name: Hook tests
        run: ./.harness/hooks/tests/run.sh

      # Pi layer: the extension handlers with a fake Pi API on top of the same hooks.
      - name: Pi layer tests
        run: bun test ./.harness/hooks/tests/pi.test.ts

      - name: Codex adapter tests
        run: bash ./.harness/hooks/tests/codex.test.sh

      - name: knowledge/ tests
        run: for t in knowledge/tests/*.sh; do "./$t" || exit 1; done

      - name: Harness update tests
        run: for t in .harness/update/tests/*.sh; do "./$t" || exit 1; done

      # The knowledge/ tables of contents are generated. A mismatch with the
      # content must be a red run. `git status --porcelain`, not
      # `git diff --exit-code`: diff is blind to added and deleted files.
{% if doc_form == 'monolith' %}
      # In the monolith form the TOC script belongs to the project: without it
      # there is nothing to check. Old-form documents live anywhere, so the whole
      # tree is checked.
{% endif %}
      - name: Tables of contents built
        run: |
{% if doc_form == 'monolith' %}
          [ -e knowledge/index.sh ] || exit 0
{% endif %}
          ./knowledge/index.sh
          status=$(git status --porcelain{% if doc_form == 'catalog' %} -- knowledge/{% endif %})
          if [ -n "$status" ]; then
            printf 'Tables of contents diverged from the content: run ./knowledge/index.sh and commit:\n%s\n' "$status" >&2
            exit 1
          fi
